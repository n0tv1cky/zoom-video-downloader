{
  "term": "MSDSM Batch 6 - Term 1",

  "dailyRunTime": "09:00",

  "timeSlots": {
    "note": "Used only to narrow the search window for continuous-recording splitting (see docs/continuous-recording-splitting.md) -- never as the cut point itself. Duplicated from the sibling attendance/calendar-sync projects' own timeSlots, deliberately not shared -- keep in sync by hand if the schedule ever changes.",
    "weekday": [
      { "label": "Session-I", "start": "19:00", "end": "20:00" },
      { "label": "Session-II", "start": "20:15", "end": "21:15" }
    ],
    "weekend": [
      { "label": "Session-I", "start": "10:45", "end": "11:45" },
      { "label": "Session-II", "start": "12:00", "end": "13:00" },
      { "label": "Session-III", "start": "14:45", "end": "15:45" },
      { "label": "Session-IV", "start": "16:00", "end": "17:00" }
    ]
  },

  "recordingsSheet": {
    "id": "<YOUR_RECORDINGS_SHEET_ID>",
    "gid": "0"
  },

  "columns": {
    "date": "Date",
    "time": "Time",
    "courseCode": "Course Code with Session No.",
    "faculty": "Faculty",
    "linkActiveFrom": "Link active from date",
    "linkActiveTo": "To Date",
    "link": "Recording Link"
  },

  "outputDir": "../../docs/recordings/videos/MSDSM_Batch6_Term1",
  "organizeByCourse": true,
  "stateFile": "~/.zoom-recordings-sync/msdsm-batch6-term1-state.json",

  "chrome": {
    "useSystemProfile": false,
    "userDataDir": "",
    "snapshotDir": "~/.zoom-recordings-sync/chrome-snapshot",
    "profileDirectory": "Profile 3",
    "profileEmailHint": "<YOUR_INSTITUTE_EMAIL>"
  },
  "chromeProfileDir": "~/.zoom-recordings-sync/chrome-profile",

  "googleOAuth": {
    "clientSecretFile": "./oauth-client.json",
    "tokenFile": "~/.zoom-recordings-sync/google-oauth-token.json"
  },

  "notifications": {
    "toEmail": "<YOUR_INSTITUTE_EMAIL>",
    "additionalRecipients": [],
    "tokenFile": "~/.zoom-recordings-sync/gmail-token.json",
    "note": "Separate Gmail-send-only OAuth token from googleOAuth above -- see lib/gmailAuth.mjs for why. from == toEmail (own account, Gmail send-only token can only send as itself); additionalRecipients are extra To: addresses that get the report but aren't the sending account."
  },

  "driveUpload": {
    "enabled": true,
    "rootFolderId": "<YOUR_DRIVE_ROOT_FOLDER_ID>",
    "organizeByCourse": true,
    "deleteLocalAfterUpload": true
  },

  "fileNameTemplate": "{courseCode}_{date}_{faculty}.mp4",

  "subjectCodeMap": {
    "ME": "DSM 107",
    "MC": "DSM 104",
    "BR": "DSM 106",
    "SM": "DSM 108",
    "MP": "DSM 109",
    "PS": "DSM 101",
    "PFDS": "DSM 102",
    "DS": "DSM 103"
  },

  "courseFaculty": {
    "note": "Transcribed from the schedule sheet's own instructor legend (last tab) -- used only to flag (never auto-correct) a Faculty-column value in the recordings sheet that doesn't match any listed instructor for that course. Re-transcribe if the legend changes (e.g. next term).",
    "DSM 101": ["Prof. Suman Majumdar", "Prof. Arshad", "Prof. Ruchi Sharma", "Prof. Pritee Sharma"],
    "DSM 102": ["Prof. Abhirup Datta", "Prof. Saurabh Das"],
    "DSM 103": ["Dr. Somnath Dey", "Dr. Surya Prakash"],
    "DSM 104": ["Prof. Varun Rijhwani"],
    "DSM 106": ["Prof. Jagannathan Srinath"],
    "DSM 107": ["Prof. Deepak Sethia", "Prof. Karthikeya Naraparaju"],
    "DSM 108": ["Prof. Ray Sanjog"],
    "DSM 109": ["Prof. Amit Kumar Vatsa"]
  }
}
